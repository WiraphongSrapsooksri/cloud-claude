# Copy to .env (never commit .env). Every strategy setting below is optional;
# unset values fall back to the defaults in bot/config.py.

# --- Broker ---
BROKER=paper            # paper | mt5
LIVE_TRADING=no         # must be "yes" before the mt5 broker sends real orders
SYMBOL=XAUUSDm          # Exness Standard = XAUUSDm, Pro/Raw/Zero = XAUUSD, Standard Cent = XAUUSDc
TIMEFRAME=M15           # M5 | M15 | M30 | H1 | H4
POLL_SECONDS=10

# --- MetaTrader 5 (Windows only; use a DEMO account first) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=             # e.g. Exness-MT5Trial7 (copy the exact name from the Exness personal area)
MT5_PATH=               # optional: path to terminal64.exe
MT5_MAGIC=20261016

# --- Strategy (examples) ---
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
GRID_STEP_ATR=1.0
MAX_GRID_LEVELS=4
BASE_LOT=0.01
LOT_MULTIPLIER=1.0
TP_ATR=1.5
SL_ATR=1.0

# --- FVG filter (off | confirm | retest) ---
# confirm/10/0.5 was the only setting positive on both H1 (~2.4y) and M15 (60d)
# in backtests on GC=F; its neighbours were not, so treat it as a hypothesis to
# forward-test on demo, not a proven edge.
FVG_MODE=confirm
FVG_LOOKBACK=10
FVG_MIN_ATR=0.5
